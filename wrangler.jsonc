{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "perthsaver",
  "main": "server/server/index-worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
